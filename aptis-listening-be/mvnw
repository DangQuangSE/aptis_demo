# ----------------------------------------------------------------------------
# Maven Start Up Batch script
#
# Required ENV vars:
# JAVA_HOME - Location of a JDK home dir
#
# Optional ENV vars
# MAVEN_OPTS - parameters passed to the Java VM when running Maven
#     e.g. to debug Maven itself, use
#     set MAVEN_OPTS=-Xdebug -Xrunjdwp:transport=dt_socket,server=y,suspend=y,address=8000
# ----------------------------------------------------------------------------

CLASSWORLDS_LAUNCHER=org.codehaus.plexus.classworlds.launcher.Launcher

# Save project base directory
PRG="$0"
while [ -h "$PRG" ] ; do
  ls=`ls -ld "$PRG"`
  link=`expr "$ls" : '.*-> \(.*\)$'`
  if expr "$link" : '/.*' > /dev/null; then
    PRG="$link"
  else
    PRG=`dirname "$PRG"`/["$link"]
  fi
done
SAVED="`pwd`"
cd "`dirname \"$PRG\"`" >/dev/null
exec_dir="`pwd`"
cd "$SAVED" >/dev/null

# Find the project base dir, i.e. the directory that contains the folder ".mvn".
# Fallback to current directory if not found.
project_base_dir="$exec_dir"
while [ ! -d "$project_base_dir/.mvn" ] && [ "$project_base_dir" != "/" ]; do
  project_base_dir=`dirname "$project_base_dir"`
done
if [ "$project_base_dir" = "/" ]; then
  project_base_dir="$exec_dir"
fi

# Locate java
if [ -n "$JAVA_HOME" ] ; then
  if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
    # IBM's JDK on AIX uses jre/sh/java instead of jre/bin/java
    JAVACMD="$JAVA_HOME/jre/sh/java"
  else
    JAVACMD="$JAVA_HOME/bin/java"
  fi
else
  JAVACMD="java"
fi

if [ ! -x "$JAVACMD" ] ; then
  echo "Error: JAVA_HOME is not defined correctly." >&2
  echo "  We cannot execute $JAVACMD" >&2
  exit 1
fi

WRAPPER_JAR="$project_base_dir/.mvn/wrapper/maven-wrapper.jar"
WRAPPER_PROPERTIES="$project_base_dir/.mvn/wrapper/maven-wrapper.properties"
WRAPPER_LAUNCHER=org.apache.maven.wrapper.MavenWrapperMain

# Extension to allow automatic download of the maven-wrapper.jar from the web
if [ ! -f "$WRAPPER_JAR" ]; then
    echo "Downloading Maven Wrapper JAR..."
    # use curl or wget to download the jar
    if command -v curl >/dev/null 2>&1; then
        curl -sSLo "$WRAPPER_JAR" https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.2.0/maven-wrapper-3.2.0.jar
    elif command -v wget >/dev/null 2>&1; then
        wget -q -O "$WRAPPER_JAR" https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.2.0/maven-wrapper-3.2.0.jar
    else
        echo "Error: curl or wget is required to download Maven Wrapper JAR." >&2
        exit 1
    fi
fi

# Execute Maven Wrapper
exec "$JAVACMD" \
  $MAVEN_OPTS \
  -classpath "$WRAPPER_JAR" \
  "-Dmaven.multiModuleProjectDirectory=$project_base_dir" \
  $WRAPPER_LAUNCHER "$@"
