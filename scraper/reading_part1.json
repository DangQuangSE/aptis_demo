lex align-items-center\">\n    <a href=\"/reading_question\" class=\"me-3 text-decoration-none text-dark fs-4\">\n      <i class=\"bi bi-house-door-fill me-2\"></i> <!-- House Icon from Bootstrap Icons -->\n      <span>Aptis Keys</span>\n    </a>\n  </div>\n\n  <!-- Center Section (Countdown Timer) -->\n  <div class=\"d-flex align-items-center\">\n    <span class=\"time-remaining-label me-2 fs-6\">Time remaining:</span>\n    <span class=\"countdown fs-4\" id=\"countdownTimer\">34:49</span>\n  </div>\n\n  <!-- Right Section (Current Step) -->\n  <div id=\"question_step\" class=\"fs-5 fw-bold\">\n    Reading Question 1\n  </div>\n</div>\n<!-- ====================================================================================\n                  Question 1\n======================================================================================== -->\n    <!-- Question 1 -->\n    <div id=\"question1\" class=\"container py-5\">\n        <h1 id=\"question1_header\" class=\"mb-4\">Reading Question 1 (1/13)</h1>\n        <p class=\"mb-4\">Choose the word that fits in the gap. The first one is done for you.</p>\n        <a>Hey Lewis,<br><br></a>\n        <form id=\"questionForm\">\n            <div id=\"questions-container\"><div class=\"mb-3 d-flex align-items-center border p-3 rounded shadow-sm bg-light\"><label class=\"form-label me-3\" for=\"gap0\">Where is the train</label><select class=\"form-select w-auto\" id=\"gap0\" name=\"gap0\"><option value=\"\"></option><option value=\"station\">station</option><option value=\"school\">school</option><option value=\"market\">market</option></select><span class=\"ms-3\">in this town?</span></div><div class=\"mb-3 d-flex align-items-center border p-3 rounded shadow-sm bg-light\"><label class=\"form-label me-3\" for=\"gap1\">The bus</label><select class=\"form-select w-auto\" id=\"gap1\" name=\"gap1\"><option value=\"\"></option><option value=\"runs\">runs</option><option value=\"stops\">stops</option><option value=\"flies\">flies</option></select><span class=\"ms-3\">here every morning.</span></div><div class=\"mb-3 d-flex align-items-center border p-3 rounded shadow-sm bg-light\"><label class=\"form-label me-3\" for=\"gap2\">The traffic light is</label><select class=\"form-select w-auto\" id=\"gap2\" name=\"gap2\"><option value=\"\"></option><option value=\"red\">red</option><option value=\"yellow\">yellow</option><option value=\"green\">green</option></select><span class=\"ms-3\">so you can go now.</span></div><div class=\"mb-3 d-flex align-items-center border p-3 rounded shadow-sm bg-light\"><label class=\"form-label me-3\" for=\"gap3\">We usually have</label><select class=\"form-select w-auto\" id=\"gap3\" name=\"gap3\"><option value=\"\"></option><option value=\"breakfast\">breakfast</option><option value=\"lunch\">lunch</option><option value=\"dinner\">dinner</option></select><span class=\"ms-3\">at 7 p.m.</span></div><div class=\"mb-3 d-flex align-items-center border p-3 rounded shadow-sm bg-light\"><label class=\"form-label me-3\" for=\"gap4\">Do you like watching</label><select class=\"form-select w-auto\" id=\"gap4\" name=\"gap4\"><option value=\"\"></option><option value=\"books\">books</option><option value=\"movies\">movies</option><option value=\"hotdog\">hotdog</option></select><span class=\"ms-3\">on weekends?</span></div></div>\n        </form>\n        <a><br>Love,<br>Helen<br><br><br></a>\n    </div>\n\n\n\n\n    \n\n\n<!-- ============================================\n                  Modal for Test Result\n================================================ -->\n<div class=\"modal fade\" id=\"resultModal\" tabindex=\"-1\" aria-labelledby=\"resultModalLabel\" aria-hidden=\"true\">\n  <div class=\"modal-dialog\">\n    <div class=\"modal-content\">\n      <div class=\"modal-header\">\n        <h5 class=\"modal-title\" id=\"resultModalLabel\">Test and Answer Review keys 001</h5>\n        <button type=\"button\" class=\"btn-close\" data-bs-dismiss=\"modal\" aria-label=\"Close\"></button>\n      </div>\n      <div class=\"modal-body text-center\">\n        <h5 id=\"totalScore\"></h5> <!-- Hiển thị điểm tổng -->\n        <h5 id=\"scoreClassification\"></h5> <!-- Hiển thị phân loại điểm -->\n\n        <!-- Bảng so sánh kết quả -->\n        <table class=\"table table-bordered mt-4\">\n          <thead>\n            <tr>\n              <th scope=\"col\">Your Answer</th>\n              <th scope=\"col\">Correct Answer</th>\n            </tr>\n          </thead>\n          <tbody id=\"comparisonTableBody\">\n            <!-- Các kết quả so sánh sẽ được hiển thị tại đây -->\n          </tbody>\n        </table>\n      </div>\n    </div>\n  </div>\n</div>\n\n\n\n\n\n\n<!-- ============================================\n                  FOOTER SECTION\n================================================ -->\n<div class=\"footer\">\n    <button class=\"btn btn-back\" id=\"backButton\">Back</button>\n    <button class=\"btn btn-check-result\" id=\"checkResultButton\">Check result</button>\n    <button class=\"btn btn-next\" id=\"nextButton\">Next</button>\n</div>\n\n\n<!-- ============================================\n                  POPUP XÁC NHẬN BÀI THI\n================================================ -->\n    <!-- Modal Popup for Confirm and Cancel -->\n    <div class=\"modal fade\" id=\"confirmationModal\" tabindex=\"-1\" aria-labelledby=\"confirmationModalLabel\" aria-hidden=\"true\">\n        <div class=\"modal-dialog\">\n            <div class=\"modal-content\">\n                <div class=\"modal-header\">\n                    <h5 class=\"modal-title\" id=\"confirmationModalLabel\">Confirm Submission</h5>\n                    <button type=\"button\" class=\"btn-close\" data-bs-dismiss=\"modal\" aria-label=\"Close\"></button>\n                </div>\n                <div class=\"modal-body\">\n                    Are you sure you want to submit your test? Once submitted, you can't change your answers.\n                </div>\n                